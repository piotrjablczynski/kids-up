{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/kidsup_web"
  },
  "tasks": [
    {
      "label": "kidsup: install dependencies",
      "type": "npm",
      "script": "install",
      "path": "kidsup_web",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "kidsup: dev server",
      "type": "npm",
      "script": "dev",
      "path": "kidsup_web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in|compiled|Local:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "kidsup: build",
      "type": "npm",
      "script": "build",
      "path": "kidsup_web",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "group": "build"
    },
    {
      "label": "kidsup: start (production)",
      "type": "npm",
      "script": "start",
      "path": "kidsup_web",
      "dependsOn": ["kidsup: build"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
